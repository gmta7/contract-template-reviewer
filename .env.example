# 复制本文件为 .env 后填写真实值（.env 不会提交到 git）
# Windows 示例：copy .env.example .env

# ── LLM（OpenAI 兼容接口，可选） ──
# 不填也能跑：模版比对、邮箱核查、日期规则审核仍可用
# 不填会受影响：乙方成立日期查询、非模版合同 AI 初审、部分关键信息 LLM 提取
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 可选：覆盖默认目录 ──
# CONTRACT_TEMPLATES_DIR=
# COMPANY_EMAILS_FILE=
