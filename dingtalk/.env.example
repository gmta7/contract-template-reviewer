# ── 钉钉集成必填项 ──────────────────────────────────────────
# 在钉钉开放平台 https://open-dev.dingtalk.com 创建企业内部应用后获取
DINGTALK_APP_KEY=dingxxxxxxxxxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 合同审批模板的 processCode（在审批模板详情页 URL 中可以看到，格式 PROC-XXXXXXXX）
DINGTALK_PROCESS_CODE=PROC-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# 发表审批评论所使用的员工 userId（在钉钉开放平台「通讯录」接口可查，或联系管理员）
DINGTALK_BOT_USER_ID=xxxxxxxxxx

# ── LLM（可选，用于非模版合同初审和公司信息查询） ────────────────
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── 模版目录（与 Web UI 共用，默认为项目内 contract_templates 目录） ──
# CONTRACT_TEMPLATES_DIR=C:\path\to\your\templates
